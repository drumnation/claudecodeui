{
  "extends": "./tooling/typescript/node.json",
  "compilerOptions": {
    "outDir": "./server/dist",
    "rootDir": "./server",
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./server/.tsbuildinfo",
    "types": ["node", "vitest/globals"],
    "baseUrl": "./server",
    "paths": {
      "@core/*": ["core/*"],
      "@adapters/*": ["adapters/*"],
      "@services/*": ["services/*"],
      "@routes/*": ["routes/*"],
      "@ws/*": ["ws/*"],
      "@types/*": ["types/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "server/**/*.js",
    "server/**/*.json"
  ],
  "exclude": [
    "server/node_modules",
    "server/dist",
    "server/__tests__",
    "server/**/*.test.ts",
    "server/**/*.test.js"
  ],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  }
}