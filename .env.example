# Server configuration
PORT=8765
VITE_PORT=8766
VITE_API_PORT=8765

# Frontend will run on http://localhost:8766
# Backend API will run on http://localhost:8765

# Session Summary Generation
# Set to 'false' to disable AI-based title generation (will use pattern matching instead)
USE_AI_TITLES=true

# OpenAI API Configuration (Server-side only for security)
# Required only if USE_AI_TITLES=true
# OPENAI_API_KEY=your_openai_api_key_here

# Continuous Session Summary Updates
# How many user messages before updating the session summary (default: 3, set to 0 to disable)
SESSION_SUMMARY_UPDATE_INTERVAL=3

# Delay in milliseconds before updating summary to ensure messages are saved (default: 2000)
SESSION_SUMMARY_UPDATE_DELAY=2000

# Claude CLI Configuration
# Optional: Specify custom path to Claude CLI executable
# If not set, the system will search for 'claude' in PATH
# CLAUDE_CLI_PATH=
# Example: CLAUDE_CLI_PATH=/usr/local/bin/claude
# Example: CLAUDE_CLI_PATH=/custom/path/to/claude
# Note: Path must be absolute and point to executable file
# This is useful for Docker containers, custom installations, or when Claude CLI is not in PATH