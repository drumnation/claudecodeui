# Server configuration
PORT=8765
VITE_PORT=8766
VITE_API_PORT=8765

# Frontend will run on http://localhost:8766
# Backend API will run on http://localhost:8765

# Session Summary Generation
# Set to 'false' to disable AI-based title generation (will use pattern matching instead)
USE_AI_TITLES=true

# OpenAI API Configuration (Server-side only for security)
# Required only if USE_AI_TITLES=true
# OPENAI_API_KEY=your_openai_api_key_here

# Continuous Session Summary Updates
# How many user messages before checking/updating the session summary (default: 5, set to 0 to disable)
SESSION_SUMMARY_UPDATE_INTERVAL=5

# Delay in milliseconds before updating summary to ensure messages are saved (default: 2000)
SESSION_SUMMARY_UPDATE_DELAY=2000

# Detect topic changes in conversations and update titles accordingly (default: true)
DETECT_TOPIC_CHANGES=true

# Claude CLI Configuration
# Optional: Specify custom path to Claude CLI executable
# If not set, the system will search for 'claude' in PATH
# CLAUDE_CLI_PATH=
# Example: CLAUDE_CLI_PATH=/usr/local/bin/claude
# Example: CLAUDE_CLI_PATH=/custom/path/to/claude
# Note: Path must be absolute and point to executable file
# This is useful for Docker containers, custom installations, or when Claude CLI is not in PATH

# Mobile Development via Ngrok
# NGROK_URL is automatically set by the ngrok startup script
# This enables proper HMR/WebSocket functionality when testing on mobile devices
# NGROK_URL=https://your-subdomain.ngrok.io
#
# Usage:
# 1. Run: npm run ngrok:start (starts ngrok and sets NGROK_URL in .env.local)
# 2. Run: npm run client:dev (starts Vite with proper ngrok configuration)
# 3. Or use: npm run ngrok:dev (starts backend + ngrok + frontend all together)
#
# The NGROK_URL environment variable tells Vite to configure HMR for mobile:
# - Uses WSS protocol on port 443 for secure WebSocket connections
# - Sets the correct hostname for ngrok tunnel
# - Enables proper hot module reloading on mobile browsers

# Logger Configuration
# Frontend log level: silent, error, warn, info, debug, trace
VITE_LOG_LEVEL=info

# Frontend logger theme: Classic, Dracula, Solarized, Nord, Gruvbox, NightOwl, Monochrome
VITE_LOG_THEME=Classic

# Backend log level: silent, error, warn, info, debug, trace
LOG_LEVEL=warn

# Development vs Production recommendations:
# Frontend:
# - Development: VITE_LOG_LEVEL=debug for detailed debugging
# - Production: VITE_LOG_LEVEL=info to reduce noise
# - CI/CD: VITE_LOG_LEVEL=warn with Monochrome theme
#
# Backend:
# - Development: LOG_LEVEL=warn to reduce WebSocket noise
# - Production: LOG_LEVEL=error for minimal logging
# - Debug mode: LOG_LEVEL=debug for troubleshooting
# 
# Performance considerations:
# - Trace level can impact performance in production
# - Debug level recommended for development only
# - Info level provides good balance for staging