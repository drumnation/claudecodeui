{
  "name": "@claude-code-ui/backend-standalone",
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone package.json for testing without workspace",
  "scripts": {
    "dev": "sh ./start-dev.sh",
    "dev:minimal": "tsx watch src/main-minimal.ts",
    "start": "node dist/src/main.js",
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.24",
    "@kit/env-loader": "workspace:*",
    "@kit/logger": "workspace:*",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "fast-glob": "^3.3.3",
    "form-data": "^4.0.3",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.0.0",
    "openai": "^4.71.0",
    "pino": "^9.5.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^2.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.0"
  }
}