# Claude Code UI Backend Configuration

# Port configuration
PORT=8765
VITE_API_PORT=8765
VITE_PORT=8766

# OpenAI Configuration (for AI-powered features)
OPENAI_API_KEY=your_openai_api_key_here

# Session Configuration
USE_AI_TITLES=true
SESSION_SUMMARY_UPDATE_INTERVAL=5
DETECT_TOPIC_CHANGES=true

# CLI Configuration
# Custom path to the backlog CLI (optional)
# If not set, the system will search PATH and common npm global directories
# BACKLOG_CLI_PATH=/custom/path/to/backlog

# Custom path to the claude CLI (optional)
# CLAUDE_CLI_PATH=/custom/path/to/claude

# Custom path to the Claude AI CLI binary (optional)
# Required for Multi-Agent Planner feature
# If not set, the system will search PATH for 'claude'
# CLAUDE_BINARY=/custom/path/to/claude

# Troubleshooting CLI Issues
# If you're experiencing "CLI not found" errors:
# 1. Ensure the CLI is installed globally: npm install -g backlog.md
# 2. Check that npm global bin directory is in your PATH
# 3. For custom installations, set the appropriate _CLI_PATH variable above

# Database Configuration (if needed in future)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Logging Configuration
# LOG_LEVEL=info
# LOG_FORMAT=json