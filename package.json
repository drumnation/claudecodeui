{
  "name": "claude-code-ui",
  "version": "1.0.0",
  "description": "A web-based UI for Claude Code CLI",
  "main": "apps/backend/dist/main.js",
  "scripts": {
    "backend:dev": "cd apps/backend && npm run dev",
    "clean:dist": "rm -rf dist && rm -rf node_modules/.vite",
    "dev": "concurrently --kill-others --names \"API,WEB\" --name-color \"bgBlue.bold,bgGreen.bold\" --prefix \"{name}\" --prefix-color \"auto\" \"npm run backend:dev\" \"cd apps/frontend && npm run dev\"",
    "ngrok": "node scripts/start-ngrok.js",
    "ngrok:start": "node scripts/start-ngrok.js",
    "dev:ngrok": "npm run ngrok:start && cd apps/frontend && npm run dev",
    "ngrok:dev": "concurrently --kill-others --names \"API,NGROK,WEB\" --name-color \"bgBlue.bold,bgMagenta.bold,bgGreen.bold\" --prefix \"{name}\" --prefix-color \"auto\" \"npm run backend:dev\" \"npm run ngrok:start\" \"cd apps/frontend && npm run dev\"",
    "prod": "node scripts/start-prod.js",
    "backend:start": "node apps/backend/dist/main.js",
    "start": "cd apps/frontend && npm run build && npm run backend:start",
    "test:backend": "cd apps/backend && npm test",
    "test:backend:watch": "cd apps/backend && npm run test:watch",
    "test:backend:coverage": "cd apps/backend && npm run test:coverage",
    "typecheck:backend": "cd apps/backend && npm run typecheck",
    "build:backend": "cd apps/backend && npm run build",
    "frontend:dev": "cd apps/frontend && npm run dev",
    "frontend:build": "cd apps/frontend && npm run build",
    "frontend:storybook": "cd apps/frontend && npm run storybook",
    "frontend:test": "cd apps/frontend && npm run test",
    "frontend:typecheck": "cd apps/frontend && npm run typecheck",
    "brain:validate": "brain-monitor validate",
    "brain:validate-critical": "brain-monitor validate-critical",
    "brain:validate-quick": "brain-monitor validate-quick",
    "brain:watch": "brain-monitor watch",
    "brain:typecheck-failures": "brain-monitor typecheck",
    "brain:lint-failures": "brain-monitor lint",
    "brain:format-failures": "brain-monitor format",
    "brain:test-failures": "brain-monitor test",
    "brain:test-storybook-failures": "brain-monitor test-storybook",
    "brain:test-storybook-comprehensive": "brain-monitor test-storybook --comprehensive",
    "brain:test-e2e-smoke": "brain-monitor test-e2e --type smoke",
    "brain:test-e2e-api": "brain-monitor test-e2e --type api",
    "brain:test-e2e-critical": "brain-monitor test-e2e --type critical",
    "brain:test-e2e-visual": "brain-monitor test-e2e --type visual",
    "brain:test-e2e-performance": "brain-monitor test-e2e --type performance",
    "brain:validate-extended": "brain-monitor validate-extended",
    "test:frontend": "cd apps/frontend && npm run test",
    "test:e2e": "cd apps/frontend && npm run test:e2e",
    "test:e2e:smoke": "cd apps/frontend && npm run test:e2e:smoke",
    "test:frontend:storybook": "cd apps/frontend && npm run test:storybook:unit",
    "test:frontend:e2e": "cd apps/frontend && npm run test:storybook:e2e",
    "test:frontend:integration": "cd apps/frontend && npm run test:storybook:integration",
    "test:storybook:all": "cd apps/frontend && npm run test:storybook:integration",
    "test:performance": "concurrently --kill-others-on-fail \"npm run test:backend -- --reporter=verbose\" \"npm run test:frontend -- --reporter=verbose\"",
    "test:performance:backend": "cd apps/backend && time npm test -- --reporter=verbose",
    "test:performance:frontend": "cd apps/frontend && time npm test -- --reporter=verbose",
    "test:fast": "concurrently --kill-others-on-fail \"cd apps/backend && npm run test:fast\" \"cd apps/frontend && npm run test:fast\"",
    "test:components": "cd apps/frontend && npm run test:components",
    "test:features": "cd apps/frontend && npm run test:features",
    "test:hooks": "cd apps/frontend && npm run test:hooks",
    "test:modules": "cd apps/backend && npm run test:modules",
    "test:services": "cd apps/backend && npm run test:services",
    "test:controllers": "cd apps/backend && npm run test:controllers",
    "brain:logs": "brain-monitor logs",
    "brain:dev": "brain-monitor dev"
  },
  "keywords": [
    "claude",
    "ai",
    "code",
    "ui",
    "assistant"
  ],
  "author": "Claude Code UI Contributors",
  "license": "MIT",
  "dependencies": {
    "@kit/brain-monitor": "workspace:*",
    "@kit/logger": "workspace:*",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fast-glob": "^3.3.3",
    "form-data": "^4.0.3",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.0.0",
    "openai": "^5.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "concurrently": "^8.2.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2020": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    }
  }
}
