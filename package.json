{
  "name": "claude-code-ui",
  "version": "1.0.0",
  "description": "A web-based UI for Claude Code CLI",
  "main": "server/index.js",
  "scripts": {
    "build-storybook": "storybook build",
    "backend:dev": "cd apps/backend && npm run dev",
    "build": "vite build",
    "clean:dist": "rm -rf dist && rm -rf node_modules/.vite",
    "client:dev": "vite serve --host --port 8766 --force --clearScreen false",
    "client": "vite --host --port 8766",
    "dev": "concurrently --kill-others \"npm run backend:dev\" \"npm run client:dev\"",
    "fix:imports": "node scripts/fixImports.js",
    "list:imports": "node scripts/listBrokenImports.js",
    "ngrok": "node scripts/start-ngrok.js",
    "preview": "vite preview",
    "prod": "node scripts/start-prod.js",
    "server:dev": "NODE_ENV=development node server/index.js",
    "server": "node server/index.js",
    "start": "npm run build && npm run server",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:backend": "vitest run --config server/vitest.config.js",
    "test:backend:watch": "vitest watch --config server/vitest.config.js",
    "test:backend:ui": "vitest --ui --config server/vitest.config.js",
    "test:backend:coverage": "vitest run --coverage --config server/vitest.config.js",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "build:server": "tsc --project tsconfig.server.json",
    "dev:server:ts": "NODE_ENV=development tsx server/index.js",
    "test:server:coverage": "vitest run --coverage --config server/vitest.config.js"
  },
  "keywords": [
    "claude",
    "ai",
    "code",
    "ui",
    "assistant"
  ],
  "author": "Claude Code UI Contributors",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.24",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.38.0",
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@kit/brain-monitor": "workspace:*",
    "@storybook/testing-library": "^0.2.2",
    "@tailwindcss/typography": "^0.5.16",
    "@uiw/react-codemirror": "^4.23.13",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fast-glob": "^3.3.3",
    "form-data": "^4.0.3",
    "lucide-react": "^0.515.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.0.0",
    "openai": "^5.8.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.8.1",
    "tailwind-merge": "^3.3.1",
    "twin.macro": "^3.4.1",
    "vite-console-forward-plugin": "^1.0.0",
    "ws": "^8.14.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.0.1",
    "@emotion/babel-plugin": "^11.13.5",
    "@storybook/addon-a11y": "^9.0.15",
    "@storybook/addon-docs": "^9.0.15",
    "@storybook/addon-vitest": "^9.0.15",
    "@storybook/react-vite": "^9.0.15",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.53.2",
    "postcss": "^8.4.32",
    "prop-types": "^15.8.1",
    "sharp": "^0.34.2",
    "storybook": "^9.0.15",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "vite-plugin-babel-macros": "^1.0.6",
    "vitest": "^3.2.4"
  },
  "babelMacros": {
    "twin": {
      "preset": "emotion"
    }
  }
}
