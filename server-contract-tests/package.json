{
  "name": "server-contract-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "Contract tests to ensure compatibility between server implementations",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:current": "SERVER_TYPE=current vitest run",
    "test:refactored": "SERVER_TYPE=refactored vitest run",
    "test:compare": "npm run test:current && npm run test:refactored && node src/compare-results.js",
    "start:current": "cd ../server && node index.js",
    "start:refactored": "cd ../apps/backend && npm run dev"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "axios": "^1.10.0",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "supertest": "^6.3.3",
    "vitest": "^1.0.0",
    "ws": "^8.18.3"
  }
}
